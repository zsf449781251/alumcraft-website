# Tencent Exmail SMTP. Copy to .env only for your own local tooling; never commit secrets.
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AlumCraft Website
INQUIRY_TO_EMAIL=znegshifan@yushiglobal.cn
SMTP_TIMEOUT=15

# Optional comma-separated origins in addition to the request's own host.
ALLOWED_ORIGINS=https://9gygp5h788.coze.site

# Coze supplies PORT in production. This value is convenient for local use.
PORT=5000
