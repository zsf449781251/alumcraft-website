# Dedicated QQ Mail SMTP account for website inquiry delivery.
# Keep the real client authorization code in Coze Secrets, never in Git.
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=449781251@qq.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=449781251@qq.com
SMTP_FROM_NAME=AlumCraft Website
INQUIRY_TO_EMAIL=449781251@qq.com
SMTP_TIMEOUT=15

# Optional comma-separated origins in addition to the current request host.
ALLOWED_ORIGINS=https://9gygp5h788.coze.site

# Coze supplies PORT in production. This value is convenient for local use.
PORT=5000
